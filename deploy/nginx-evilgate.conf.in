# evilgate.online — the merged site, API and pool files behind one vhost.
#
# Unlike the retired hub vhost on :8444 (an IP certificate, a spare port on a
# shared box), this one is a name-based vhost on :443: `server_name` selects it,
# so the host's other sites keep their own :443 blocks untouched.
#
# TLS: a Let's Encrypt certificate for evilgate.online. Issue it with
#   certbot certonly --nginx -d evilgate.online -d www.evilgate.online
# and let the existing renewal timer reload nginx. `ssl_certificate` below
# points at the default lineage certbot writes.
#
# Do not log query strings or bearer-token subscription paths: the safe format
# keeps operational metadata and redacts token-bearing URIs.
map $uri $request_uri_redacted {
    default $uri;
    ~^/sub/ "/sub/[redacted]";
    ~^/api/v1/sub/ "/api/v1/sub/[redacted]";
}
log_format evilgate_safe '$remote_addr - [$time_local] "$request_method $request_uri_redacted" '
                         '$status $body_bytes_sent "$http_user_agent"';

upstream evilgate_app {
    server 127.0.0.1:8090;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=evilgate_sub:10m rate=10r/s;

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name evilgate.online www.evilgate.online;

    ssl_certificate     /etc/letsencrypt/live/evilgate.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/evilgate.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:evilgate:10m;
    ssl_session_timeout 1d;

    server_tokens off;

    access_log /var/log/nginx/evilgate.access.log evilgate_safe;
    error_log  /var/log/nginx/evilgate.error.log warn;

    # Subscription fetches are the hottest path; the app also rate-limits, and
    # nginx caps a scanner before it reaches Python.
    location ^~ /sub/ {
        limit_req zone=evilgate_sub burst=20 nodelay;
        proxy_pass http://evilgate_app;
        include /etc/nginx/proxy_params;
    }
    location ^~ /api/v1/sub/ {
        limit_req zone=evilgate_sub burst=20 nodelay;
        proxy_pass http://evilgate_app;
        include /etc/nginx/proxy_params;
    }

    # Pool line files can be several megabytes; stream them without buffering
    # the whole body in nginx.
    location ^~ /pool/ {
        proxy_pass http://evilgate_app;
        include /etc/nginx/proxy_params;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://evilgate_app;
        include /etc/nginx/proxy_params;
        proxy_read_timeout 60s;
    }
}
