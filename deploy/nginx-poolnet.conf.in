# poolnet.online — the merged site, API and pool files behind one vhost.
#
# Unlike the retired hub vhost on :8444 (an IP certificate, a spare port on a
# shared box), this one is a name-based vhost on :443: `server_name` selects it,
# so the host's other sites keep their own :443 blocks untouched.
#
# TLS: a Let's Encrypt certificate for poolnet.online. Issue it with
#   certbot certonly --webroot -w /var/www/certbot -d poolnet.online -d www.poolnet.online
# (the :80 block below serves the challenge), then reload nginx. The existing
# renewal timer picks the lineage up from /etc/letsencrypt/live/poolnet.online.
#
# Do not log query strings or bearer-token subscription paths: the safe format
# keeps operational metadata and redacts token-bearing URIs.
map $uri $request_uri_redacted {
    default $uri;
    ~^/sub/ "/sub/[redacted]";
    ~^/api/v1/sub/ "/api/v1/sub/[redacted]";
}
log_format PoolNet_safe '$remote_addr - [$time_local] "$request_method $request_uri_redacted" '
                         '$status $body_bytes_sent "$http_user_agent"';

upstream PoolNet_app {
    server 127.0.0.1:8090;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=PoolNet_sub:10m rate=10r/s;

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name poolnet.online www.poolnet.online;

    ssl_certificate     /etc/letsencrypt/live/poolnet.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/poolnet.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:poolnet:10m;
    ssl_session_timeout 1d;

    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # One canonical host: www answers a redirect, so links and cookies do not
    # split between two names.
    if ($host = www.poolnet.online) {
        return 301 https://poolnet.online$request_uri;
    }

    access_log /var/log/nginx/poolnet.access.log PoolNet_safe;
    error_log  /var/log/nginx/poolnet.error.log warn;

    # Prometheus metrics are for the operator over localhost/SSH, never the
    # public origin. The app stays reachable for scraping through the tunnel.
    location = /metrics {
        return 404;
    }

    # Subscription fetches are the hottest path; the app also rate-limits, and
    # nginx caps a scanner before it reaches Python.
    location ^~ /sub/ {
        limit_req zone=PoolNet_sub burst=20 nodelay;
        proxy_pass http://poolnet_app;
        include /etc/nginx/proxy_params;
    }
    location ^~ /api/v1/sub/ {
        limit_req zone=PoolNet_sub burst=20 nodelay;
        proxy_pass http://poolnet_app;
        include /etc/nginx/proxy_params;
    }

    # The interactive mobile concept. It is a static demo, not the API.
    location = /app {
        return 301 /app/;
    }
    location ^~ /app/ {
        root /home/dev/poolnet/web/site;
        index index.html;
        try_files $uri $uri.html $uri/ =404;
    }

    # Pool line files can be several megabytes; stream them without buffering
    # the whole body in nginx.
    location ^~ /pool/ {
        proxy_pass http://poolnet_app;
        include /etc/nginx/proxy_params;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://poolnet_app;
        include /etc/nginx/proxy_params;
        proxy_read_timeout 60s;
    }
}

# HTTP: ACME challenges for the certificate, everything else goes to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name poolnet.online www.poolnet.online;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://poolnet.online$request_uri;
    }
}
