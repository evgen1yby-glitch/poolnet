{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "local"
      },
      {
        "type": "udp",
        "server": "198.18.0.2",
        "tag": "dns-remote"
      },
      {
        "type": "tls",
        "server": "198.18.0.2",
        "tag": "dns-remote-doh"
      }
    ]
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "tag": "🇰🇷 Корея 1",
      "server": "152.69.226.63",
      "server_port": 25555,
      "type": "vless",
      "uuid": "27c5483f-17f4-48ae-9a04-def53d88440d",
      "transport": {
        "type": "ws",
        "path": "/",
        "headers": {
          "Host": "152.69.226.63"
        }
      }
    },
    {
      "type": "urltest",
      "tag": "🇰🇷 Корея",
      "outbounds": [
        "🇰🇷 Корея 1"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 150,
      "idle_timeout": "30m",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "🇰🇷 Корея",
        "direct"
      ]
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "inbound": "mixed-in"
      },
      {
        "action": "route",
        "outbound": "direct",
        "port": 53
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "action": "route",
        "outbound": "dns-remote",
        "rule_set": [
          "geosite-ru"
        ]
      },
      {
        "action": "resolve"
      },
      {
        "action": "route",
        "outbound": "proxy"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-ru",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-ru.srs",
        "download_detour": "direct"
      }
    ],
    "final": "proxy"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "cache_id": "8e95c53e7876c7c1"
    }
  }
