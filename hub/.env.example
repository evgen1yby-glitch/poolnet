# Copy to /etc/hub/hub.env (or wherever `EnvironmentFile=` points) and edit.
#
# Nothing here has a default worth shipping. A checked-in origin or token is one
# deployment's value, wrong for every other install — which is why the config
# file carries neither and the deployment supplies them here.

# The public origin this hub is reachable at, e.g. https://203.0.113.10:8444
#
# Read by BOTH the API and the bot, so the subscription headers and the links
# the bot hands out cannot disagree. Empty means the URL-bearing headers
# (`profile-web-page-url`, `support-url`) are dropped rather than rendered
# blank, and the bot emits no absolute links at all.
HUB_BASE_URL=

# Bearer token for the operator subscription, and the shared secret the bot
# uses to call `/api/v1/bot/issue` and `/api/v1/sub/revoke`.
#
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Anyone holding this can poll the subscription and mint tokens, so treat it as
# a password: 0640 root:astrobot, never in Git. The database stores only its
# SHA-256 digest for issued subscriptions, but this value is compared directly.
HUB_TOKEN=

# Shared secret for `/admin` and for the bot's calls to `/api/v1/bot/issue` and
# `/api/v1/sub/revoke`. Generate one:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Unlike HUB_TOKEN this value is compared directly rather than hashed, so it must
# stay out of Git. Without it the operator panel is closed — which is the safe
# direction, and the panel says so when it refuses.
HUB_BOT_SECRET=

# Telegram bot token and channel, only if you run the bot. Leave both empty for
# the shipped default, which is a hub with no bot — the landing page's country
# cards then render as plain unlinked divs rather than linking to a bot that
# does not exist.
TELEGRAM_BOT_TOKEN=
HUB_CHANNEL_ID=

# Locale for country names and bot messages: ru (default) or en.
HUB_LOCALE=ru

# --- Tuning, all optional -------------------------------------------------
#
# Nodes verified within this many hours still count as working, so a round that
# samples a different part of the pool does not drop nodes it did not probe.
# One probe interval by default. 0 disables the carry-over entirely.
HUB_RECENT_HOURS=8

# Cap on nodes a source may contribute per round before it has 10 rounds of
# history. The cap bounds *novelty*, not volume: every node is probed before
# publication, so a large new source contributes failures rather than nodes.
HUB_QUARANTINE_CAP=2000

# Probe concurrency and per-stage timeouts, in seconds.
HUB_TOP_N=60
HUB_MAX_LOAD=none
HUB_TCP_TIMEOUT=2.0
HUB_TLS_TIMEOUT=3.0
HUB_HTTP_TIMEOUT=5.0

# Paths to the cores used for validation. `sing-box` validates every sing-box
# payload before publication; `xray` validates the balancer config and, without
# it, a structural check runs instead.
SINGBOX_BIN=/usr/local/bin/sing-box
XRAY_BIN=/opt/hub-tools/xray

# Set to 0 to skip the geo-IP lookup that names nodes the probe could not
# place. On by default; the lookup only runs for nodes the probe left blank.
HUB_GEO_LOOKUP=1
